# Firebase Web App config (Console → Project settings → Your apps → Web app)
# VITE_* values are bundled into the browser — public by design, not secret.
# Restrict abuse via Firebase Console → Authentication / App Check / API key restrictions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — Analytics / GA4 (same as measurementId in firebaseConfig)
VITE_FIREBASE_MEASUREMENT_ID=

# Admin SDK only (npm run seed:firestore, cleanup:orphan-people, etc.). NEVER commit this file.
# Default: crm/service-account.json (gitignored)
# FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json
