# Firebase Web App config (Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — Analytics / GA4 (same as measurementId in firebaseConfig)
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — for `npm run seed:firestore` only (Admin SDK JSON path, not sent to the browser)
FIREBASE_SERVICE_ACCOUNT_PATH=
