{
  "name": "crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "seed:firestore": "node --env-file=.env scripts/seed-firestore.cjs",
    "bootstrap:user": "node --env-file=.env scripts/bootstrap-auth-and-seed.cjs",
    "set:founder": "node --env-file=.env scripts/set-founder.cjs",
