rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function orgPerson(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/people/$(request.auth.uid));
    }

    function isFounder(orgId) {
      return signedIn()
        && orgPerson(orgId).data.orgRole in ['founder', 'ceo'];
    }

    // One-time registration seeds
    match /organizations/{orgId}/registrationSeeds/{seedId} {
      allow get: if true;
      allow list: if isFounder(orgId);
      allow create: if isFounder(orgId);
      allow update: if signedIn()
        && !resource.data.used
        && request.resource.data.used == true
        && request.resource.data.usedById == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedById', 'usedByEmail', 'usedAt']);
    }

    match /organizations/{orgId}/people/{personId} {
      allow read, write: if signedIn();
    }

    // Partner visibility is enforced in the client; founders manage project scope.
    match /organizations/{orgId}/tasks/{taskId} {
      allow read, write: if signedIn();
    }

    match /organizations/{orgId}/projects/{projectId} {
      allow read: if signedIn();
      allow create, update, delete: if isFounder(orgId);
    }

    match /organizations/{orgId}/appointments/{appointmentId} {
      allow read, write: if signedIn();
    }

    match /organizations/{orgId}/personalReminders/{reminderId} {
      allow read, write: if signedIn();
    }

    match /organizations/{orgId}/contacts/{contactId} {
      allow read, write: if isFounder(orgId);
    }

    match /organizations/{orgId}/contacts/{contactId}/reminders/{reminderId} {
      allow read, write: if isFounder(orgId);
    }

    match /organizations/{orgId}/notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn();
    }

    match /organizations/{orgId}/{collection}/{document=**} {
      allow read, write: if signedIn() && isFounder(orgId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;

      // Google Calendar tokens — Cloud Functions only (Admin SDK bypasses rules).
      match /integrations/{docId} {
        allow read, write: if false;
        match /events/{eventId} {
          allow read, write: if false;
        }
      }
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
