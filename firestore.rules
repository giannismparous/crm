rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function orgPerson(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/people/$(request.auth.uid));
    }

    function isFounder(orgId) {
      return signedIn()
        && orgPerson(orgId).data.orgRole in ['founder', 'ceo'];
    }

    function viewerDepts(orgId) {
      return orgPerson(orgId).data.get('departments', []);
    }

    function projectOrgWide(data) {
      let depts = data.get('departmentIds', []);
      return depts.size() == 0 || depts.hasAny(['General']);
    }

    function projectDeptOverlap(orgId, projectId) {
      let p = get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data;
      return projectOrgWide(p)
        || p.get('departmentIds', []).hasAny(viewerDepts(orgId));
    }

    function taskOrgWide(data) {
      let depts = data.get('assigneeDepartmentIds', []);
      return depts.size() == 0 || depts.hasAny(['General']);
    }

    function taskPartnerCanRead(orgId) {
      let t = resource.data;
      let hasProject = t.keys().hasAll(['projectId'])
        && t.projectId is string
        && t.projectId != '';
      return t.assigneeIds.hasAny([request.auth.uid])
        || (taskOrgWide(t) && !hasProject)
        || t.get('assigneeDepartmentIds', []).hasAny(viewerDepts(orgId))
        || (hasProject && projectDeptOverlap(orgId, t.projectId));
    }

    function taskPartnerCanCreate(orgId) {
      return signedIn();
    }

    function appointmentPartnerCanRead(orgId) {
      let a = resource.data;
      return a.createdById == request.auth.uid
        || a.participantIds.hasAny([request.auth.uid])
        || a.get('participantDepartmentIds', []).hasAny(viewerDepts(orgId));
    }

    function appointmentPartnerCanCreate(orgId) {
      return signedIn();
    }

    function reminderPartnerCanRead(orgId) {
      let r = resource.data;
      return r.get('ownerId', '') == request.auth.uid
        || r.get('participantIds', []).hasAny([request.auth.uid])
        || r.get('participantDepartmentIds', []).hasAny(viewerDepts(orgId));
    }

    function reminderPartnerCanCreate(orgId) {
      return signedIn();
    }

    function registrationSeedRef(orgId, seedId) {
      return /databases/$(database)/documents/organizations/$(orgId)/registrationSeeds/$(seedId);
    }

    function founderBootstrapEmail() {
      return 'giannismparous@gmail.com';
    }

    function isFounderBootstrapUser() {
      return signedIn()
        && request.auth.token.email == founderBootstrapEmail();
    }

    function registrationPersonCreate(orgId, personId) {
      let seedId = request.resource.data.registrationSeedId;
      let seed = get(registrationSeedRef(orgId, seedId));
      return personId == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && seed.data.orgRole == request.resource.data.orgRole
        && (seed.data.used == false || seed.data.usedById == request.auth.uid);
    }

    function founderPersonCreate(personId) {
      return personId == request.auth.uid
        && isFounderBootstrapUser()
        && request.resource.data.orgRole == 'founder';
    }

    function personSelfUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['orgRole', 'registrationSeedId', 'authUid', 'registeredAt', 'accountExpiresAt', 'departments']);
    }

    function userOrgId() {
      return resource.data.get('orgId', '');
    }

    function founderManagingUserRole() {
      return isFounder(userOrgId())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orgRole', 'updatedAt']);
    }

    function founderManagingUserDisplayName() {
      return isFounder(userOrgId())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);
    }

    function userSelfUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgRole']);
    }

    // One-time registration seeds
    match /organizations/{orgId}/registrationSeeds/{seedId} {
      allow get: if true;
      allow list: if isFounder(orgId);
      allow create: if isFounder(orgId);
      allow update: if signedIn()
        && !resource.data.used
        && request.resource.data.used == true
        && request.resource.data.usedById == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedById', 'usedByEmail', 'usedAt']);
    }

    match /organizations/{orgId}/people/{personId} {
      // Team directory — any signed-in member can browse all teammates.
      allow read: if signedIn();
      allow create: if signedIn()
        && personId == request.auth.uid
        && (registrationPersonCreate(orgId, personId) || founderPersonCreate(personId));
      allow update: if signedIn()
        && (
          isFounder(orgId)
          || (personId == request.auth.uid && personSelfUpdateOk())
        );
      allow delete: if isFounder(orgId);
    }

    match /organizations/{orgId}/tasks/{taskId} {
      allow read: if signedIn() && (isFounder(orgId) || taskPartnerCanRead(orgId));
      allow create: if signedIn() && (isFounder(orgId) || taskPartnerCanCreate(orgId));
      allow update: if signedIn() && (isFounder(orgId) || taskPartnerCanRead(orgId));
      allow delete: if isFounder(orgId);
    }

    match /organizations/{orgId}/projects/{projectId} {
      allow read: if signedIn()
        && (
          isFounder(orgId)
          || projectOrgWide(resource.data)
          || resource.data.get('departmentIds', []).hasAny(viewerDepts(orgId))
        );
      allow create, update, delete: if isFounder(orgId);
    }

    match /organizations/{orgId}/appointments/{appointmentId} {
      allow read: if signedIn() && (isFounder(orgId) || appointmentPartnerCanRead(orgId));
      allow create: if signedIn() && (isFounder(orgId) || appointmentPartnerCanCreate(orgId));
      allow update: if signedIn() && (isFounder(orgId) || appointmentPartnerCanRead(orgId));
      allow delete: if isFounder(orgId);
    }

    match /organizations/{orgId}/personalReminders/{reminderId} {
      allow read: if signedIn() && (isFounder(orgId) || reminderPartnerCanRead(orgId));
      allow create: if signedIn() && (isFounder(orgId) || reminderPartnerCanCreate(orgId));
      allow update: if signedIn() && (isFounder(orgId) || reminderPartnerCanRead(orgId));
      allow delete: if signedIn() && (isFounder(orgId) || reminderPartnerCanRead(orgId));
    }

    function salesPartnerCanAccessContacts(orgId) {
      return !isFounder(orgId) && viewerDepts(orgId).hasAny(['Sales']);
    }

    match /organizations/{orgId}/contacts/{contactId} {
      allow read, write: if isFounder(orgId) || salesPartnerCanAccessContacts(orgId);
    }

    match /organizations/{orgId}/contacts/{contactId}/reminders/{reminderId} {
      allow read, write: if isFounder(orgId) || salesPartnerCanAccessContacts(orgId);
    }

    match /organizations/{orgId}/research/{researchId} {
      allow read, write: if isFounder(orgId);
    }

    match /organizations/{orgId}/notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn();
    }

    function chatConv(orgId, convId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/chatConversations/$(convId)).data;
    }

    function chatConvMember(orgId, convId) {
      return chatConv(orgId, convId).memberIds.hasAny([request.auth.uid]);
    }

    match /organizations/{orgId}/chatConversations/{convId} {
      allow read: if signedIn() && chatConvMember(orgId, convId);
      allow create: if signedIn()
        && (
          (
            request.resource.data.memberIds.hasAny([request.auth.uid])
            && request.resource.data.kind in ['dm', 'group']
          )
          || (
            convId == 'founders'
            && request.resource.data.kind == 'founders'
            && isFounder(orgId)
          )
        );
      allow update: if signedIn()
        && (
          (
            chatConvMember(orgId, convId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['memberIds', 'lastMessageAt', 'lastMessagePreview', 'lastMessageAuthorId'])
          )
          || (
            isFounder(orgId)
            && resource.data.kind == 'founders'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          )
        );
      allow delete: if isFounder(orgId);

      match /messages/{messageId} {
        allow read: if signedIn() && chatConvMember(orgId, convId);
        allow create: if signedIn()
          && chatConvMember(orgId, convId)
          && request.resource.data.authorId == request.auth.uid;
        allow update: if isFounder(orgId);
        allow delete: if signedIn()
          && chatConvMember(orgId, convId)
          && (
            isFounder(orgId)
            || (
              resource.data.authorId == request.auth.uid
              && resource.data.createdAtMs is number
              && request.time.toMillis() <= resource.data.createdAtMs + 300000
            )
          );
      }
    }

    match /organizations/{orgId}/chatMemberState/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    match /organizations/{orgId}/presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    match /organizations/{orgId}/{collection}/{document=**} {
      allow read, write: if signedIn() && isFounder(orgId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && userId == request.auth.uid
        && (
          (
            request.resource.data.keys().hasAll(['registrationSeedId', 'orgRole', 'orgId'])
            && get(registrationSeedRef(request.resource.data.orgId, request.resource.data.registrationSeedId)).data.orgRole
                == request.resource.data.orgRole
          )
          || (
            isFounderBootstrapUser()
            && request.resource.data.orgRole == 'founder'
            && request.resource.data.get('orgId', '') != ''
          )
        );
      allow update: if signedIn()
        && (
          (userId == request.auth.uid && (isFounder(userOrgId()) || userSelfUpdateOk()))
          || founderManagingUserRole()
          || founderManagingUserDisplayName()
        );
      allow delete: if isFounder(userOrgId());

      match /integrations/{docId} {
        allow read, write: if false;
        match /events/{eventId} {
          allow read, write: if false;
        }
      }
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
