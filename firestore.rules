rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function orgPerson(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/people/$(request.auth.uid));
    }

    function isFounder(orgId) {
      return signedIn() && orgPerson(orgId).data.orgRole == 'founder';
    }

    // One-time registration seeds
    match /organizations/{orgId}/registrationSeeds/{seedId} {
      // Register page must read seed to show "invalid" vs "already used" (codes are long random ids).
      allow get: if true;
      allow list: if isFounder(orgId);
      allow create: if isFounder(orgId);
      allow update: if signedIn()
        && !resource.data.used
        && request.resource.data.used == true
        && request.resource.data.usedById == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedById', 'usedByEmail', 'usedAt']);
    }

    // SimasiaAI workspace — all other subcollections
    match /organizations/{orgId}/{document=**} {
      allow read, write: if signedIn();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
