# OAuth + app URL for Google Calendar sync (see FIREBASE_SETUP.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=
CRM_APP_URL=

# Gemini — task update title generation (generateTaskUpdateTitle)
# Production: firebase functions:secrets:set GEMINI_API_KEY
# Local emulator: firebase functions:secrets:access GEMINI_API_KEY or .secret.local
GEMINI_API_KEY=
